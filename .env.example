# Copy to .env.local and fill in. Never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS. Keep it out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Used for invitation / password-reset email links (required in production).
NEXT_PUBLIC_APP_URL=https://miqyas-blond.vercel.app

# ── Gemini (OMR scanning, class reports, name extraction) ───────────────────
GEMINI_API_KEY=
# Optional: pin the model version. Defaults to the value in lib/gemini.ts.
GEMINI_MODEL=

# ── Debug ───────────────────────────────────────────────────────────────────
# Set to "true" to include scan debug details in API responses in production.
DEBUG_SCAN=

# ── RLS isolation test (npm run test:rls) ───────────────────────────────────
RLS_TEST_SCHOOL_A_ID=
RLS_TEST_SCHOOL_B_ID=

RLS_TEST_ADMIN_EMAIL=
RLS_TEST_ADMIN_PASSWORD=
RLS_TEST_PRINCIPAL_A_EMAIL=
RLS_TEST_PRINCIPAL_A_PASSWORD=
RLS_TEST_PRINCIPAL_B_EMAIL=
RLS_TEST_PRINCIPAL_B_PASSWORD=
RLS_TEST_TEACHER_A_EMAIL=
RLS_TEST_TEACHER_A_PASSWORD=
RLS_TEST_TEACHER_B_EMAIL=
RLS_TEST_TEACHER_B_PASSWORD=
